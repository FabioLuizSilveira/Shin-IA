      "default": "./dist/entities/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@shina/typescript-config": "workspace:*",
    "typescript": "^5.7.2"
  }
}
