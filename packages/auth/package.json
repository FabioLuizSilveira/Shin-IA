{
  "name": "@shina/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./auth-service": {
      "types": "./dist/auth-service.d.ts",
      "default": "./dist/auth-service.js"
    },
    "./session-service": {
      "types": "./dist/session-service.d.ts",
      "default": "./dist/session-service.js"
    },
    "./mfa-service": {
      "types": "./dist/mfa-service.d.ts",
      "default": "./dist/mfa-service.js"
    },
    "./tenant-context": {
      "types": "./dist/tenant-context.d.ts",
      "default": "./dist/tenant-context.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "default": "./dist/events/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shina/database": "workspace:*",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "@shina/typescript-config": "workspace:*",
    "@types/node": "^20.0.0",
    "typescript": "^5.7.2"
  }
}
