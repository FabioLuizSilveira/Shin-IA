{
  "name": "@shina/authorization",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rbac": {
      "types": "./dist/rbac/index.d.ts",
      "default": "./dist/rbac/index.js"
    },
    "./abac": {
      "types": "./dist/abac/index.d.ts",
      "default": "./dist/abac/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@shina/iam-domain": "workspace:*",
    "@shina/iam-repository": "workspace:*"
  },
  "devDependencies": {
    "@shina/typescript-config": "workspace:*",
    "@supabase/supabase-js": "^2.38.0",
    "@types/node": "^20.0.0",
    "@vitest/ui": "^1.0.0",
    "typescript": "^5.7.2",
    "vitest": "^1.0.0"
  }
}
