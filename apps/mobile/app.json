{
  "expo": {
    "name": "Shinã",
    "slug": "shina-customer",
    "scheme": "shinacustomer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "br.com.shinaia.app",
      "buildNumber": "4",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.com.shinaia.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-image",
      "expo-font",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "O Shinã usa a câmera para capturar as fotos da vistoria digital."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Shinã usa sua localização para registrar onde a vistoria foi realizada (opcional)."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O Shinã usa o microfone para você falar com a Shinã por voz.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "31e2d122-3bfb-4699-87f1-7e8d5a38abb8"
      }
    },
    "owner": "shina-i-a"
  }
}
