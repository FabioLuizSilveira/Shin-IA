# Same Supabase project as apps/web / apps/mkt — rental customer access is
# authorized entirely via RLS (see supabase/migrations/20260055000000).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# M22.1 — canonical name is the publishable key. EXPO_PUBLIC_SUPABASE_ANON_KEY
# is still accepted as a legacy fallback (see src/lib/supabase.ts) if your
# project still issues keys under the older name — same key material either
# way, never a secret/service-role key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# M22.6 — base URL for the real Shinã Mobile BFF (apps/web). Bootstrap and
# every other live call target `${EXPO_PUBLIC_SHINAIA_API_URL}/api/mobile/*`.
EXPO_PUBLIC_SHINAIA_API_URL=https://api.shinaia.com.br

# DEV ONLY — never set in staging/production or any EAS build profile that
# isn't "development". __DEV__ (Metro's own build-time flag, not overridable
# by this var) is the actual enforcement boundary — see src/lib/mock-policy.ts.
# When "1", unlocks: fallback to mock data when a live call fails or the API
# URL above is unset, and the "modo demonstração" button on the login screen.
EXPO_PUBLIC_ENABLE_MOCKS=0

# Dev-only shortcut for testing a real session without completing the OAuth/
# magic-link deep link in Expo Go (see src/lib/auth-context.tsx). Never set
# outside a local .env.local (gitignored) — never in CI or any EAS profile.
# EXPO_PUBLIC_DEV_ACCESS_TOKEN=
# EXPO_PUBLIC_DEV_REFRESH_TOKEN=
