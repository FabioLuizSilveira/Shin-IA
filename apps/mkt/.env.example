# Supabase (same project as the Shinã platform — shared IAM)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Domain routing
NEXT_PUBLIC_ROOT_DOMAIN=shinaia.com.br
NEXT_PUBLIC_MKT_URL=https://mkt.shinaia.com.br
NEXT_PUBLIC_APP_URL=https://app.shinaia.com.br

# Encryption key for BYOK provider API keys (AES-256, 32 bytes base64)
MKT_ENCRYPTION_KEY=

# Billing gateway selection (@shina/billing-platform). "asaas" is the only
# supported value (Stripe -> Asaas migration completed — StripeBillingProvider
# removed once every active Stripe-backed subscriber had migrated).
# MERCADOPAGO_ACCESS_TOKEN is reserved for a possible future provider,
# unused today.
BILLING_PROVIDER=asaas
MERCADOPAGO_ACCESS_TOKEN=

# Asaas — signup checkout (subscription, no free tier; 14-day money-back
# guarantee is a documented, not-yet-reimplemented gap for this app's
# webhook — see api/webhooks/asaas/route.ts). Sandbox keys start with
# $aact_hmlg_, production keys with $aact_prod_ (must match ASAAS_ENV or
# every call 401s). ASAAS_WEBHOOK_AUTH_TOKEN is a value YOU choose and
# register in the Asaas dashboard's webhook config — Asaas echoes it back
# in every webhook's asaas-access-token header for verification.
ASAAS_API_KEY=$aact_...
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_AUTH_TOKEN=

# Google/Facebook OAuth for signup: configured in the Supabase dashboard
# (Authentication -> Providers), not via env vars here.

# Ad platform integrations (M-MKT-05) — OAuth app credentials per platform.
# Each integration stays "not configured" in /integrations until its vars
# are set. Redirect URIs to whitelist in each platform's app console:
#   {NEXT_PUBLIC_MKT_URL}/api/integrations/<platform>/callback
META_APP_ID=
META_APP_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Firebase Auth (identity migration, Phase 1) — same Firebase project as
# apps/web, so the same account works across Shinã Platform and Shinã MKT
# (spec item 25: no second Firebase project/identity pool). Not the active
# provider yet.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

IDENTITY_PROVIDER=supabase
