# Supabase (same project as the Shinã platform — shared IAM)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Domain routing
NEXT_PUBLIC_ROOT_DOMAIN=shinaia.com.br
NEXT_PUBLIC_MKT_URL=https://mkt.shinaia.com.br
NEXT_PUBLIC_APP_URL=https://app.shinaia.com.br

# Encryption key for BYOK provider API keys (AES-256, 32 bytes base64)
MKT_ENCRYPTION_KEY=

# Billing gateway selection (@shina/billing-platform). Only "stripe" is
# implemented; MERCADOPAGO_ACCESS_TOKEN is reserved for a future provider.
BILLING_PROVIDER=stripe
MERCADOPAGO_ACCESS_TOKEN=

# Stripe — signup checkout (subscription, no free tier; 14-day money-back
# guarantee handled in the webhook, not as a Stripe trial period)
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# Google/Facebook OAuth for signup: configured in the Supabase dashboard
# (Authentication -> Providers), not via env vars here.

# Ad platform integrations (M-MKT-05) — OAuth app credentials per platform.
# Each integration stays "not configured" in /integrations until its vars
# are set. Redirect URIs to whitelist in each platform's app console:
#   {NEXT_PUBLIC_MKT_URL}/api/integrations/<platform>/callback
META_APP_ID=
META_APP_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
