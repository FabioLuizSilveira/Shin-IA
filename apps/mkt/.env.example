# Supabase (same project as the Shinã platform — shared IAM)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Domain routing
NEXT_PUBLIC_ROOT_DOMAIN=shinaia.com.br
NEXT_PUBLIC_MKT_URL=https://mkt.shinaia.com.br
NEXT_PUBLIC_APP_URL=https://app.shinaia.com.br

# Encryption key for BYOK provider API keys (AES-256, 32 bytes base64)
MKT_ENCRYPTION_KEY=

# Stripe — signup checkout (subscription, no free tier; 14-day money-back
# guarantee handled in the webhook, not as a Stripe trial period)
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# Google/Facebook OAuth for signup: configured in the Supabase dashboard
# (Authentication -> Providers), not via env vars here.
