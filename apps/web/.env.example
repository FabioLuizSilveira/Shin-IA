# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Domain routing
# Root domain (without www or subdomain)
NEXT_PUBLIC_ROOT_DOMAIN=shinaia.com.br
# Public marketing site
NEXT_PUBLIC_SITE_URL=https://shinaia.com.br
# App subdomain — all auth and platform routes live here
NEXT_PUBLIC_APP_URL=https://app.shinaia.com.br
# REST/edge API base URL (if separate)
NEXT_PUBLIC_API_URL=https://api.shinaia.com.br
# Shinã MKT app URL (workspace switcher / cross-product links)
NEXT_PUBLIC_MKT_URL=https://mkt.shinaia.com.br
# Deep link scheme the rental-customer mobile app (apps/mobile) registers —
# used as the redirectTo for the "convidar cliente" invite email.
NEXT_PUBLIC_MOBILE_APP_SCHEME=shinacustomer://auth/callback

# Misc
DEMO_TENANT_ID=10000000-0000-0000-0000-000000000001

# Billing gateway selection (@shina/billing-platform). Only "stripe" is
# implemented; MERCADOPAGO_ACCESS_TOKEN is reserved for a future provider.
BILLING_PROVIDER=stripe
MERCADOPAGO_ACCESS_TOKEN=

# Stripe — invoice payment collection (tenant billing module)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# OAuth (Google/Apple/Facebook) e Magic Link: configurados no painel do
# Supabase (Authentication -> Providers / Email), não via env vars aqui.
# Redirect URL a liberar no Supabase: {NEXT_PUBLIC_APP_URL}/auth/callback
