# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Domain routing
# Root domain (without www or subdomain)
NEXT_PUBLIC_ROOT_DOMAIN=shinaia.com.br
# Public marketing site
NEXT_PUBLIC_SITE_URL=https://shinaia.com.br
# App subdomain — all auth and platform routes live here
NEXT_PUBLIC_APP_URL=https://app.shinaia.com.br
# REST/edge API base URL (if separate)
NEXT_PUBLIC_API_URL=https://api.shinaia.com.br
# Shinã MKT app URL (workspace switcher / cross-product links)
NEXT_PUBLIC_MKT_URL=https://mkt.shinaia.com.br
# Deep link scheme the rental-customer mobile app (apps/mobile) registers —
# used as the redirectTo for the "convidar cliente" invite email.
NEXT_PUBLIC_MOBILE_APP_SCHEME=shinacustomer://auth/callback

# Misc
DEMO_TENANT_ID=10000000-0000-0000-0000-000000000001

# Shinã-native TOTP step-up (RFC 6238) — independent of Supabase/Firebase's
# own MFA. Both must be 32 random bytes, base64-encoded; fall back to a
# SUPABASE_SERVICE_ROLE_KEY-derived value when unset (works, but set these
# dedicated vars in production for independent rotation).
SHINA_MFA_ENCRYPTION_KEY=
SHINA_STEPUP_COOKIE_SECRET=

# Billing gateway selection (@shina/billing-platform). "stripe" and "asaas"
# are both implemented (Stripe -> Asaas migration in progress — see
# docs/adr or the migration plan for the Fase A-F rollout); Stripe stays
# the default until Fase F confirms zero active Stripe-backed subscribers
# remain. MERCADOPAGO_ACCESS_TOKEN is reserved for a possible third
# provider, unused today.
BILLING_PROVIDER=stripe
MERCADOPAGO_ACCESS_TOKEN=

# Stripe — kept only for existing subscribers (webhooks/stripe-commercial)
# until Fase F confirms zero active Stripe-backed platform_subscriptions.
# The one-off AR/invoices module (mobile deposit/balance/renewal,
# invoices/[id]/checkout) fully migrated to Asaas in Fase C — Stripe is no
# longer used there at all.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Asaas — required unconditionally by two independent things: (1) the
# subscription BillingProvider when BILLING_PROVIDER=asaas (Fase A/B), and
# (2) the one-off AR/invoices payment module (Fase C, lib/asaas/client.ts +
# api/webhooks/asaas), which always uses Asaas regardless of
# BILLING_PROVIDER. ASAAS_API_KEY is environment-scoped: sandbox keys start
# with $aact_hmlg_, production keys with $aact_prod_ — a sandbox key against
# ASAAS_ENV=production (or vice versa) fails with 401.
# ASAAS_WEBHOOK_AUTH_TOKEN is a value YOU choose and register in the Asaas
# dashboard's webhook config (Configurações > Integrações > Webhooks) for
# BOTH webhook URLs (api/webhooks/asaas-commercial and api/webhooks/asaas)
# — Asaas echoes it back in every webhook's asaas-access-token header so
# this app can verify authenticity.
ASAAS_API_KEY=$aact_...
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_AUTH_TOKEN=

# OAuth (Google/Apple/Facebook) e Magic Link: configurados no painel do
# Supabase (Authentication -> Providers / Email), não via env vars aqui.
# Redirect URL a liberar no Supabase: {NEXT_PUBLIC_APP_URL}/auth/callback

# Firebase Auth (identity migration, Phase 1 — packages/identity's
# FirebaseIdentityProvider). Not the active provider yet: IDENTITY_PROVIDER
# stays "supabase" until Phase 2/3 homologation passes. Client/public values
# come from the Firebase project's "Web app" config (Firebase Console ->
# Project settings -> General -> Your apps).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Admin (server-only — NEVER prefix with NEXT_PUBLIC_). From a
# generated service account JSON (Firebase Console -> Project settings ->
# Service accounts -> Generate new private key). Paste the private_key
# value with literal \n escapes preserved, wrapped in quotes.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Which IdentityProvider apps/web resolves auth through — "supabase"
# (default/current) or "firebase". See packages/identity's
# resolveActiveIdentityProviderKind().
IDENTITY_PROVIDER=supabase
